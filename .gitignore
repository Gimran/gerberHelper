# Python
__pycache__/
*.py[cod]

# Локальные настройки окна: последняя папка и ручная раскладка слоёв
# (там пути к вашим проектам)
settings.json

# Реальные платы для регрессионных тестов. Без них tests/regression.py
# пропускает случаи, а не падает
tests/fixtures/

# Платы и то, что утилита и CAMtastic кладут рядом с ними
*.PcbDoc
*.Cam
*.bak*

# --- Приватное -------------------------------------------------------------
# Всё, что не должно попасть в публичный репозиторий, добавлять сюда.
